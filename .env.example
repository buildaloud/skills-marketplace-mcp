PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=skills-marketplace
MARKETPLACE_API_URL=https://marketplace.buildaloud.ai
PORT=3000

# On-demand audit trigger (pro tier — triggers GitHub Actions workflow for unknown skills)
GITHUB_TOKEN=github_pat_...
